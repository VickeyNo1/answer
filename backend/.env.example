# 通义千问 API Key (从阿里云 DashScope 控制台获取)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# JWT 密钥 (随机生成，生产环境务必更换)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# MySQL（机器A）
# 开发环境：公网 8.134.97.196；生产环境（机器B部署）：私网 172.22.207.228
MYSQL_HOST=8.134.97.196
MYSQL_PORT=3306
MYSQL_USER=answer
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=answer

# 知识库检索服务（机器A :8100，仅私网开放；本机联调可改 http://127.0.0.1:8100）
KB_BASE_URL=http://172.22.207.228:8100
KB_TOKEN=
KB_TIMEOUT=10

# CORS 允许的前端域名
CORS_ORIGINS=http://localhost:3000

[Unit]
Description=Answer Backend (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 部署目录（按实际调整）
WorkingDirectory=/opt/answer/backend
# systemd 环境 PATH 精简，需显式加入 uv 安装路径（root 安装默认在 /root/.local/bin）
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# pydantic-settings 从 WorkingDirectory 读取 backend/.env（生产填机器A 私网 172.22.207.228）
ExecStart=/root/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
